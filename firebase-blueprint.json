{
  "entities": {
    "attendance": {
      "title": "Attendance Record",
      "description": "Record of a student's prayer attendance",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "class": { "type": "string", "maxLength": 50 },
        "prayer_type": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "maxLength": 50 },
        "ai_status": { "type": "string", "maxLength": 50 },
        "ai_confidence": { "type": "number" },
        "gps_status": { "type": "string", "maxLength": 50 },
        "snapshot_photo": { "type": "string", "maxLength": 2000000 },
        "notes": { "type": "string", "maxLength": 1000 },
        "created_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "class", "prayer_type", "status", "created_at"]
    }
  },
  "firestore": {
    "attendance": {
      "schema": "attendance",
      "description": "Collection of attendance records"
    }
  }
}

